// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum BusinessType {
  FURNITURE
  MEDICAL
  ELECTRONICS
  FASHION
  GENERAL
  OTHER
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships     Membership[]
  sessions        Session[]
  sentInvitations EmployeeInvitation[] @relation("SentInvitations")
  stockMovements  StockMovement[]

  @@index([status])
  @@map("users")
}

model Organization {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  businessType BusinessType       @default(GENERAL) @map("business_type")
  status       OrganizationStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  memberships    Membership[]
  roles          Role[]
  invitations    EmployeeInvitation[]
  categories     Category[]
  brands         Brand[]
  units          Unit[]
  products       Product[]
  inventories    Inventory[]
  stockMovements StockMovement[]
  suppliers      Supplier[]

  @@index([status])
  @@index([businessType])
  @@map("organizations")
}

model Role {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  name           String
  description    String?
  status         RoleStatus @default(ACTIVE)
  isSystem       Boolean    @default(false) @map("is_system")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  memberships     Membership[]
  invitations     EmployeeInvitation[]

  @@unique([organizationId, name])
  @@unique([id, organizationId], name: "role_org_unique")
  @@index([organizationId])
  @@index([status])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([userId, organizationId], name: "user_organization_unique")
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@index([status])
  @@map("memberships")
}

model EmployeeInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String
  roleId         String           @map("role_id") @db.Uuid
  tokenHash      String           @unique @map("token_hash")
  expiresAt      DateTime         @map("expires_at")
  status         InvitationStatus @default(PENDING)
  acceptedAt     DateTime?        @map("accepted_at")
  invitedById    String?          @map("invited_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  invitedBy    User?        @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@index([roleId])
  @@index([status])
  @@index([organizationId, status])
  @@map("employee_invitations")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum UnitStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  OPENING_STOCK
  ADJUSTMENT
  PURCHASE
  SALE
  RETURN
  DAMAGE
}

model Category {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  description    String?
  status         CategoryStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@unique([id, organizationId], name: "category_org_unique")
  @@index([organizationId])
  @@index([status])
  @@map("categories")
}

model Brand {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String
  description    String?
  status         BrandStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@unique([id, organizationId], name: "brand_org_unique")
  @@index([organizationId])
  @@index([status])
  @@map("brands")
}

model Unit {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  name           String
  code           String
  description    String?
  status         UnitStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@unique([id, organizationId], name: "unit_org_unique")
  @@index([organizationId])
  @@index([status])
  @@map("units")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  description    String?
  sku            String
  barcode        String?
  categoryId     String?       @map("category_id") @db.Uuid
  brandId        String?       @map("brand_id") @db.Uuid
  unitId         String?       @map("unit_id") @db.Uuid
  costPrice      Decimal       @default(0.00) @map("cost_price") @db.Decimal(12, 2)
  sellingPrice   Decimal       @default(0.00) @map("selling_price") @db.Decimal(12, 2)
  reorderLevel   Int           @default(0) @map("reorder_level")
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  inventory    Inventory?
  movements    StockMovement[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@unique([id, organizationId], name: "product_org_unique")
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([categoryId])
  @@index([brandId])
  @@index([unitId])
  @@map("products")
}

model Inventory {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  productId        String   @unique @map("product_id") @db.Uuid
  currentQuantity  Int      @default(0) @map("current_quantity")
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([productId, organizationId], name: "inventory_product_org_unique")
  @@index([organizationId])
  @@map("inventories")
}

model StockMovement {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  productId        String            @map("product_id") @db.Uuid
  quantity         Int
  movementType     StockMovementType @map("movement_type")
  previousQuantity Int               @map("previous_quantity")
  resultingQuantity Int              @map("resulting_quantity")
  reason           String
  referenceType    String?           @map("reference_type")
  referenceId      String?           @map("reference_id")
  createdBy        String?           @map("created_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdByUser User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([productId])
  @@index([productId, createdAt])
  @@index([organizationId, createdAt])
  @@map("stock_movements")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  contactPerson  String?        @map("contact_person")
  email          String?
  phone          String?
  address        String?
  taxId          String?        @map("tax_id")
  notes          String?
  status         SupplierStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([id, organizationId], name: "supplier_org_unique")
  @@unique([organizationId, taxId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("suppliers")
}

